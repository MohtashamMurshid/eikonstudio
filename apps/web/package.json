{
  "name": "@eikonstudio/web",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source AI image generation platform built with Next.js, Convex, Google Gemini 3 Pro, and OpenAI GPT Image 2. Text-to-image, image editing, personal gallery, and a public REST API.",
  "homepage": "https://eikonstudio.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohtashamMurshid/eikonstudio.git"
  },
  "bugs": {
    "url": "https://github.com/MohtashamMurshid/eikonstudio/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Mohtasham Murshid",
    "email": "mohtashammurshid@gmail.com",
    "url": "https://github.com/MohtashamMurshid"
  },
  "keywords": [
    "ai",
    "image-generation",
    "gemini",
    "gpt-image",
    "openai",
    "nextjs",
    "convex",
    "tailwindcss"
  ],
  "scripts": {
    "build": "pnpm --filter @eikonstudio/core build && next build",
    "precodegen": "pnpm --filter @eikonstudio/core build",
    "codegen": "convex codegen",
    "predev": "pnpm --filter @eikonstudio/core build",
    "dev": "next dev",
    "predev:convex": "pnpm --filter @eikonstudio/core build",
    "dev:convex": "convex dev",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "start": "next start",
    "pretest": "pnpm --filter @eikonstudio/core build",
    "test": "vitest run",
    "pretypecheck": "pnpm --filter @eikonstudio/core build",
    "typecheck": "tsc --noEmit"
  },
