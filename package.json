{
  "name": "eikon-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source AI image generation platform built with Next.js, Convex, Google Gemini 3 Pro, and OpenAI GPT Image 2. Text-to-image, image editing, personal gallery, and a public REST API.",
  "homepage": "https://eikonstudio.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohtashamMurshid/eikonstudio.git"
  },
  "bugs": {
    "url": "https://github.com/MohtashamMurshid/eikonstudio/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Mohtasham Murshid",
    "email": "mohtashammurshid@gmail.com",
    "url": "https://github.com/MohtashamMurshid"
  },
  "scripts": {
    "build": "turbo run build",
    "codegen": "pnpm --filter @eikonstudio/web codegen",
    "dev": "turbo run dev",
    "dev:convex": "pnpm --filter @eikonstudio/web dev:convex",
    "lint": "turbo run lint",
    "start": "pnpm --filter @eikonstudio/web start",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "2.10.8"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.18.3+sha512.bbd16e6d7286fd7e01f6b3c0b3c932cda2965c06a908328f74663f10a9aea51f1129eea615134bf992831b009eabe167ecb7008b597f40ff9bc75946aadfb08d"
}
